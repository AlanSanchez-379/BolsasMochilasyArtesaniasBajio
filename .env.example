FLASK_APP=run.py
FLASK_ENV=development
SECRET_KEY=changeme-dev-secret

# Postgres connection string from Supabase (Project Settings > Database)
# Remember to URL-encode special characters in the password (e.g. # -> %23)
DATABASE_URL=postgresql://postgres:your-password@db.your-project-ref.supabase.co:5432/postgres

# Supabase Project Settings > API
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Stripe Dashboard > Developers > API keys / Webhooks
STRIPE_SECRET_KEY=
STRIPE_PUBLISHABLE_KEY=
STRIPE_WEBHOOK_SECRET=

# Skydropx Pro (cotizacion y guias de envio), OAuth2 client_credentials.
# pro.skydropx.com/merchant_stores/applications (produccion) o
# sb-pro.skydropx.com/merchant_stores/applications (sandbox) > Conexiones > API
SKYDROPX_API_BASE_URL=https://pro.skydropx.com
SKYDROPX_CLIENT_ID=
SKYDROPX_CLIENT_SECRET=
SKYDROPX_MOCK_MODE=true

FRONTEND_ORIGIN=http://localhost:5173
