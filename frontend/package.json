{
  "name": "bma-bajio-frontend",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build:css": "tailwindcss -i ./src/styles/input.css -o ./dist/styles.css",
    "watch:css": "tailwindcss -i ./src/styles/input.css -o ./dist/styles.css --watch",
    "serve": "live-server --port=5173 --entry-file=index.html",
    "dev": "npm run build:css && concurrently \"npm:watch:css\" \"npm:serve\""
  },
  "devDependencies": {
    "concurrently": "^8.2.2",
    "live-server": "^1.2.2",
    "tailwindcss": "^3.4.10"
  }
}
